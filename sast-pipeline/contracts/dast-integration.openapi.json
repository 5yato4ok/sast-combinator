            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2PingResponseSchema"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2ErrorSchema"
                }
              }
            },
            "description": "Authentication error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Ping V2"
      }
    },
