            "items": {
              "$ref": "#/components/schemas/V2TargetSchema"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "V2TerminalResultSchema": {
        "additionalProperties": false,
        "properties": {
          "audit": {
            "additionalProperties": {},
            "type": "object"
