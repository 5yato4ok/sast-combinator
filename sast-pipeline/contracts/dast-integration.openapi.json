          "dast_run_metadata": {
            "$ref": "#/components/schemas/V2RunMetadataSchema"
          },
          "report": {
            "additionalProperties": {},
            "type": "object"
          },
          "run_id": {
            "type": "string"
          },
          "selection": {
            "additionalProperties": {},
            "type": "object"
          },
          "status": {
            "enum": [
              "succeeded",
              "completed_with_degradation",
              "failed_with_partial_results",
              "failed",
              "stopped"
            ],
            "type": "string"
          },
          "trigger_resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/V2TriggerResolutionSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object"
      },
      "V2TriggerResolutionSchema": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
