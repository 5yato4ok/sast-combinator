{
  "components": {
    "schemas": {
      "V2ErrorSchema": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "UNSUPPORTED_CONTRACT",
              "UNSUPPORTED_TRIGGER_TYPE",
              "AUTHENTICATION_FAILED",
              "PROVIDER_CREDENTIALS_EXPIRED",
              "POLICY_DENIED",
              "UNKNOWN_RUN",
              "IDEMPOTENCY_CONFLICT",
              "CAPACITY_BUSY",
              "CAPABILITY_REVISION_MISMATCH",
              "RUN_NOT_TERMINAL",
              "NO_ELIGIBLE_STAND",
              "SOURCE_DRIFT",
              "REPORT_MISSING",
              "REPORT_INVALID",
              "AUDIT_INCOMPLETE",
              "RESPONSE_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL_ERROR"
            ],
            "type": "string"
          },
          "correlation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "V2LogEventSchema": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "V2LogsResponseSchema": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/V2LogEventSchema"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "V2PingResponseSchema": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "gateway_version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "V2RunAcceptedSchema": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "V2RunMetadataSchema": {
        "additionalProperties": true,
        "properties": {
          "source_commits": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "source_commits"
        ],
        "type": "object"
      },
      "V2RunRequestSchema": {
        "additionalProperties": false,
        "properties": {
          "capability_revision": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {},
            "type": [
              "object",
              "null"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "trigger": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "repository_key": {
                    "type": "string"
                  },
                  "type": {
                    "const": "GIT_BRANCH",
                    "type": "string"
                  }
                },
                "required": [
                  "repository_key",
                  "type",
                  "ref"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "repository_key": {
                    "type": "string"
                  },
                  "type": {
                    "const": "GIT_HASH",
                    "type": "string"
                  }
                },
                "required": [
                  "repository_key",
                  "type",
                  "ref"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "repository_key": {
                    "type": "string"
                  },
                  "type": {
                    "const": "FILE_HASH",
                    "type": "string"
                  }
                },
                "required": [
                  "repository_key",
                  "type",
                  "ref"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "capability_revision",
          "contract_version",
          "correlation_id",
          "idempotency_key",
          "target_id"
        ],
        "type": "object"
      },
