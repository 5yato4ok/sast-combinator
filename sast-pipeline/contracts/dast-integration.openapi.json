          "contract_version": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_ready": {
            "type": "boolean"
          },
          "run_id": {
            "type": "string"
          },
          "selection": {
            "additionalProperties": {},
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "selecting",
              "running",
              "stop_requested",
              "succeeded",
              "completed_with_degradation",
              "failed_with_partial_results",
              "failed",
              "stopped"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "V2StopResponseSchema": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_ready": {
            "type": "boolean"
          },
          "run_id": {
            "type": "string"
          },
          "selection": {
            "additionalProperties": {},
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "selecting",
              "running",
              "stop_requested",
              "succeeded",
              "completed_with_degradation",
              "failed_with_partial_results",
              "failed",
              "stopped"
            ],
            "type": "string"
          },
          "stop_requested": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "V2TargetSchema": {
        "additionalProperties": false,
        "properties": {
          "autonomous_ready": {
            "type": "boolean"
          },
          "capability_revision": {
            "type": "string"
          },
          "contract_revision": {
            "type": "string"
          },
          "defaults": {
            "additionalProperties": {},
            "type": "object"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "launch_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parameter_schema": {
            "additionalProperties": {},
            "type": "object"
          },
          "repository_keys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schema_digest": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "V2TargetsResponseSchema": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "etag": {
            "type": "string"
